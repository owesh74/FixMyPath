<?xml version="1.0" encoding="utf-8"?>
<!--
    FIXES:
    1. Added gps_text TextView to show live lat/lon so user can confirm GPS is working.
    2. Added model_text TextView to show whether ONNX or heuristic is active.
    3. Added padding and card-style background to dataText for readability.
    4. ScrollView wrapping prevents content being cut off on small screens.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#F5F5F5">

        <!-- App title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚧 FixMyPath"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Pothole Detection"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp"/>

        <!-- Status (POTHOLE / SMOOTH) -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Waiting..."
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="24dp"/>

        <!-- GPS coordinates -->
        <TextView
            android:id="@+id/gps_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 GPS: acquiring..."
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>

        <!-- Model status -->
        <TextView
            android:id="@+id/model_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 Model: loading..."
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <!-- Sensor data card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR DATA"
                android:textSize="11sp"
                android:textColor="#999999"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/dataText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for sensor..."
                android:textSize="15sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp"
                android:fontFamily="monospace"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>